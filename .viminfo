"8	LINE	0
	#!/usr/bin/bash
	
	hello() {
		echo $0
	
		for i in $(seq 1 2 8); do
			echo $i
		done
	}
	
	declare -A site=(["google"]="www.google.com" ["runoob"]="www.runoob.com" ["taobao"]="www.taobao.com")
	# 打印特定的元素
	echo ${site["google"]}
	# 打印所有的键和值
	#for animal in "${!animals[@]}"; do
	#	echo "The $animal goes ${animals[$animal]}"
	#done
