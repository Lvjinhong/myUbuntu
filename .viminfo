	#!/bin/bash
	
	# 源文件夹和目标文件夹路径
	SOURCE_DIR="gggg"
	TARGET_DIR=""
	
	# 使用 rsync 同步文件夹   --delete选项会删除目标文件夹中没有的文件
	rsync -avhP  "$SOURCE_DIR" "$TARGET_DIR"
	
	echo "同步完成。"
|3,0,6,1,10,0,1703250514,"#!/bin/bash","","# 源文件夹和目标文件夹路径","SOURCE_DIR=\"gggg\"","TARGET_DIR=\"\"","","# 使用 rsync 同步文件夹   --delete选项会删除目标文件夹中没有的文件","rsync -avhP  \"$SOURCE_DIR\" \"$TARGET_DIR\"","","echo \"同步完成。\""
"7	LINE	0
	function lib_installed()
	{
	    /sbin/ldconfig -N -v $(sed 's/:/ /g' <<< $LD_LIBRARY_PATH) 2>/dev/null | grep $1 | sed -e 's/^\t*//' -e 's/.*=>//'
	}
	
	function check() {
	    lib_path=$(lib_installed $1)
	    if [ -n "$lib_path" ]; then
	        echo "$1 is installed at $lib_path"
	    else
	        echo "ERROR: $1 is NOT installed"
	    fi
	}
	
	# 使用示例
	# 检测 libcudnn
	check "libcudnn"
	
|3,0,7,1,18,0,1702648925,"function lib_installed()","{","    /sbin/ldconfig -N -v $(sed 's/:/ /g' <<< $LD_LIBRARY_PATH) 2>/dev/null | grep $1 | sed -e 's/^\\t*//' -e 's/.*=>//'","}","","function check() {","    lib_path=$(lib_installed $1)","    if [ -n \"$lib_path\" ]; then","        echo \"$1 is installed at $lib_path\"","    else","        echo \"ERROR: $1 is NOT installed\"","    fi","}","","# 使用示例","# 检测 libcudnn","check \"libcudnn\"",""
